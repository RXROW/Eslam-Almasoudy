{% liquid
  assign image_top = section.settings.image_left
  assign image_right = section.settings.image_right
%}

<div class="section section--full-width">
  <div
    class="candidate-banner"
    style="
      --top-width: {{ section.settings.top_width_pct | default: 100 }}%;
      --top-height: {{ section.settings.top_height_pct | default: 30 }}vh;
      --right-width: {{ section.settings.right_width_pct | default: 50 }}%;
      --right-height: {{ section.settings.right_height_pct | default: 30 }}vh;
    "
  >
    <div class="candidate-banner__top">
      {% if image_top != blank %}
        {{
          image_top
          | image_url: width: 2400
          | image_tag:
            class: 'candidate-banner__image',
            loading: 'eager',
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw'
        }}
      {% endif %}
    </div>

    <div class="candidate-banner__content">
      {% if section.settings.heading != blank %}
        <h1 class="candidate-banner__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="candidate-banner__description">{{ section.settings.description }}</div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="candidate-banner__button"
        >
          <span>{{ section.settings.button_text }}</span>
          <span class="candidate-banner__button-arrow">→</span>
        </a>
      {% endif %}
    </div>

    <div class="candidate-banner__right">
      {% if image_right != blank %}
        {{
          image_right
          | image_url: width: 1600
          | image_tag:
            class: 'candidate-banner__image',
            loading: 'eager',
            widths: '600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw'
        }}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .candidate-banner-section .candidate-banner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--right-width));
    grid-template-rows: var(--top-height) var(--right-height);
    width: 100%;
    background: #fff;
  }

  .candidate-banner-section .candidate-banner__top {
    grid-column: 1 / -1;
    grid-row: 1;
    display: flex;
    justify-content: flex-end;
    overflow: hidden;
  }

  .candidate-banner-section .candidate-banner__content {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    padding: clamp(32px, 4vw, 72px) clamp(24px, 5vw, 80px);
    background: #fff;
  }

  .candidate-banner-section .candidate-banner__right {
    grid-column: 2;
    grid-row: 2;
    overflow: hidden;
  }

  .candidate-banner-section .candidate-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .candidate-banner-section .candidate-banner__top .candidate-banner__image {
    width: var(--top-width);
    max-width: 100%;
  }

  .candidate-banner-section .candidate-banner__heading {
    margin: 0 0 20px;
    max-width: 14ch;
    font-size: clamp(36px, 4.2vw, 72px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -1.5px;
    color: #000;
  }

  .candidate-banner-section .candidate-banner__description {
    max-width: 42ch;
    margin-bottom: 28px;
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.6;
    color: #000;
  }

  .candidate-banner-section .candidate-banner__button {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    min-width: 125px;
    padding: 14px 18px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-size: 12px;
    line-height: 1;
    text-transform: uppercase;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .candidate-banner-section .candidate-banner__button-arrow {
    transition: transform 0.25s ease;
  }

  .candidate-banner-section .candidate-banner__button:hover {
    background: #222;
    transform: translateY(-2px);
  }

  .candidate-banner-section .candidate-banner__button:hover .candidate-banner__button-arrow {
    transform: translateX(5px);
  }

  @media screen and (max-width: 989px) {
    .candidate-banner-section .candidate-banner {
      position: relative;
      grid-template-columns: 1fr;
      grid-template-rows: var(--top-height) var(--right-height);
    }

    .candidate-banner-section .candidate-banner__top,
    .candidate-banner-section .candidate-banner__right {
      grid-column: 1;
    }

    .candidate-banner-section .candidate-banner__top {
      grid-row: 1;
    }

    .candidate-banner-section .candidate-banner__top .candidate-banner__image {
      width: 100%;
    }

    .candidate-banner-section .candidate-banner__right {
      grid-row: 2;
    }

    .candidate-banner-section .candidate-banner__content {
      position: absolute;
      inset: 0;
      z-index: 2;
      justify-content: flex-end;
      padding: 28px var(--page-margin, 16px) 36px;
      background: linear-gradient(
        to top,
        rgb(255 255 255 / 0.94) 0%,
        rgb(255 255 255 / 0.72) 42%,
        rgb(255 255 255 / 0) 100%
      );
    }
  }

  @media screen and (max-width: 749px) {
    .candidate-banner-section .candidate-banner__content {
      padding: 24px 16px 28px;
    }

    .candidate-banner-section .candidate-banner__heading {
      max-width: 12ch;
      margin-bottom: 12px;
      font-size: clamp(32px, 9vw, 42px);
    }

    .candidate-banner-section .candidate-banner__description {
      max-width: 36ch;
      margin-bottom: 20px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Candidate Banner",
  "class": "candidate-banner-section",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_left", "label": "Top image" },
    { "type": "range", "id": "top_width_pct", "label": "Top image width", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "top_height_pct", "label": "Top image height", "min": 10, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "image_picker", "id": "image_right", "label": "Right image" },
    { "type": "range", "id": "right_width_pct", "label": "Right image width", "min": 20, "max": 80, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "right_height_pct", "label": "Right image height", "min": 10, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Candidate Banner" }
  ]
}
{% endschema %}
